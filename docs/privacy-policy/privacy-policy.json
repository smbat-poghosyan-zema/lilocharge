    "thirdPartyServices": [
      {
        "name": "Mapbox",
        "purpose": "maps_navigation",
        "dataShared": ["location"],
        "privacyPolicy": "https://www.mapbox.com/legal/privacy"
      },
      {
        "name": "ArCa",
        "purpose": "payment_processing",
        "dataShared": ["payment_tokens"],
        "privacyPolicy": "https://www.arca.am"
      },
      {
        "name": "Idram",
        "purpose": "payment_processing",
        "dataShared": ["payment_tokens"],
        "privacyPolicy": "https://www.idram.am"
      },
      {
        "name": "Firebase Cloud Messaging",
        "purpose": "push_notifications",
        "dataShared": ["device_token"],
        "privacyPolicy": "https://firebase.google.com/support/privacy"
      }
    ],
    "retention": {
      "account_data": "until_account_active",
      "charging_history": "2_years",
      "payment_transactions": "7_years",
      "technical_data": "90_days"
    },
    "userRights": ["access", "rectification", "deletion", "export", "restriction", "objection"],
    "security": [
      "ssl_tls_encryption",
      "bcrypt_password_hashing",
      "regular_security_audits",
      "limited_server_access",
      "regular_backups"
    ],
    "ageRestriction": 16,
    "availableLanguages": ["hy", "ru", "en"]
