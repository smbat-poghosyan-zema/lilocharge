{
  "name": "@lilocharge/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "./index.js",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.js",
    "test:e2e": "detox test",
    "test:e2e:ios": "detox test --configuration ios.sim.release",
    "test:e2e:android": "detox test --configuration android.emu.release",
    "screenshots:generate": "./scripts/generate-screenshots.sh all",
    "screenshots:ios": "./scripts/generate-screenshots.sh ios",
    "screenshots:android": "./scripts/generate-screenshots.sh android",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist coverage .expo"
  },
  "dependencies": {
    "@lilocharge/shared-types": "workspace:*",
    "@rnmapbox/maps": "^10.1.36",
    "expo": "~51.0.39",
    "expo-router": "~3.5.23",
    "expo-status-bar": "~1.12.1",
    "i18next": "^25.8.10",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-i18next": "^16.5.4",
    "react-native": "0.74.5",
    "react-native-mmkv": "^2.12.2",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "~3.31.1",
    "react-native-web": "~0.19.13",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/react": "~18.2.79",
    "babel-preset-expo": "~11.0.6",
    "detox": "^20.28.3",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.4",
    "react-test-renderer": "18.2.0",
    "ts-jest": "^29.2.5"
  }
}
