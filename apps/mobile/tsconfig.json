{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "module": "esnext",
    "types": ["jest", "react-native", "expo-router"],
    "resolveJsonModule": true
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "e2e/**/*.ts",
    "store-assets/**/*.ts",
    "expo-env.d.ts",
    "jest.setup.ts",
    ".expo/types/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
