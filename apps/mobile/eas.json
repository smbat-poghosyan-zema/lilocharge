{
  "cli": {
    "version": ">= 10.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:3000",
        "EXPO_PUBLIC_MAPBOX_TOKEN": "REPLACE_WITH_MAPBOX_PUBLIC_TOKEN",
        "EXPO_PUBLIC_PUSH_ENABLED": "0",
        "EXPO_PUBLIC_APPLE_PAY_MERCHANT_ID": "merchant.com.lilocharge",
        "EXPO_PUBLIC_GOOGLE_PAY_MERCHANT_ID": "REPLACE_WITH_GOOGLE_PAY_MERCHANT_ID"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api-staging.lilocharge.am",
        "EXPO_PUBLIC_MAPBOX_TOKEN": "REPLACE_WITH_MAPBOX_PUBLIC_TOKEN",
        "EXPO_PUBLIC_PUSH_ENABLED": "1",
        "EXPO_PUBLIC_APPLE_PAY_MERCHANT_ID": "merchant.com.lilocharge",
        "EXPO_PUBLIC_GOOGLE_PAY_MERCHANT_ID": "REPLACE_WITH_GOOGLE_PAY_MERCHANT_ID"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.lilocharge.am",
        "EXPO_PUBLIC_MAPBOX_TOKEN": "REPLACE_WITH_MAPBOX_PUBLIC_TOKEN",
        "EXPO_PUBLIC_PUSH_ENABLED": "1",
        "EXPO_PUBLIC_APPLE_PAY_MERCHANT_ID": "merchant.com.lilocharge",
        "EXPO_PUBLIC_GOOGLE_PAY_MERCHANT_ID": "REPLACE_WITH_GOOGLE_PAY_MERCHANT_ID"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
