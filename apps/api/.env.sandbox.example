# Payment Gateway Sandbox Environment Variables
# Copy this file to .env.sandbox and fill in your actual sandbox credentials

# Database (required for all tests)
DATABASE_URL=postgresql://postgres:password@localhost:5432/lilocharge_test
REDIS_URL=redis://localhost:6379

# JWT (required for API authentication)
JWT_SECRET=test-jwt-secret-change-in-production

# ============================================================================
# ArCa Sandbox Configuration
# ============================================================================
# Armenian card payment gateway - sandbox environment
# Documentation: https://developers.arca.am/sandbox
# 
# To obtain sandbox credentials:
# 1. Register at https://sandbox.arca.am/merchant/register
# 2. Complete merchant verification
# 3. Generate API key from merchant dashboard
# 4. Note your merchant ID from account settings

ARCA_API_KEY=sandbox-api-key-placeholder
ARCA_MERCHANT_ID=sandbox-merchant-id-placeholder
ARCA_BASE_URL=https://sandbox.arca.am/api/v1

# Test Cards (provided by ArCa sandbox):
# - Success: 4111111111111111 (CVV: 123, Exp: 12/25)
# - Decline: 4000000000000002 (CVV: 123, Exp: 12/25)
# - Insufficient: 4000000000009995 (CVV: 123, Exp: 12/25)

# ============================================================================
# Idram Test Environment Configuration
# ============================================================================
# Armenian digital wallet - test environment
# Documentation: https://developers.idram.am/test
#
# To obtain test credentials:
# 1. Register at https://test.idram.am/merchant/register
# 2. Complete KYC verification (simplified for test)
# 3. Generate API key from merchant panel
# 4. Create test wallets for different scenarios

IDRAM_API_KEY=test-idram-api-key-placeholder
IDRAM_BASE_URL=https://test.wallet.idram.am/api/v1

# Test Wallets (create in Idram test dashboard):
# - Standard wallet: test-wallet-001 (Balance: 100,000 AMD)
# - Low balance: test-wallet-002 (Balance: 100 AMD)
# - Frozen: test-wallet-003 (Status: FROZEN)

# ============================================================================
# Apple Pay Sandbox Configuration
# ============================================================================
# iOS contactless payments - sandbox environment
# Documentation: https://developer.apple.com/apple-pay/sandbox-testing/
#
# To obtain sandbox credentials:
# 1. Register as Apple Developer (requires paid account)
# 2. Create Merchant ID in Certificates, Identifiers & Profiles
# 3. Configure payment processor (ArCa in our case)
# 4. Generate processing certificate
# 5. Configure token exchange endpoint with payment processor

APPLE_PAY_API_KEY=sandbox-apple-pay-api-key-placeholder
APPLE_PAY_MERCHANT_IDENTIFIER=merchant.com.lilocharge.sandbox
APPLE_PAY_TOKEN_EXCHANGE_URL=https://apple-pay-gateway.sandbox/v1/tokens/exchange

# Note: If APPLE_PAY_TOKEN_EXCHANGE_URL is not set, local deterministic
# tokenization will be used (suitable for development, not for production)

# Test Cards (use with Apple Pay sandbox):
# - Use test cards from Wallet app in iOS Simulator
# - Visa: Add any valid test Visa card
# - MasterCard: Add any valid test MasterCard

# ============================================================================
# Google Pay Test Environment Configuration
# ============================================================================
# Android contactless payments - test environment
# Documentation: https://developers.google.com/pay/api/android/guides/test-and-deploy
#
# To obtain test credentials:
# 1. Register at Google Pay Business Console
# 2. Create test merchant account
# 3. Configure payment processor (ArCa in our case)
# 4. Obtain merchant ID and API credentials
# 5. Configure token exchange endpoint

GOOGLE_PAY_API_KEY=test-google-pay-api-key-placeholder
GOOGLE_PAY_MERCHANT_ID=lilocharge-test-merchant-id
GOOGLE_PAY_TOKEN_EXCHANGE_URL=https://google-pay-gateway.test/v1/tokens/exchange

# Note: If GOOGLE_PAY_TOKEN_EXCHANGE_URL is not set, local deterministic
# tokenization will be used (suitable for development, not for production)

# Test Cards (use with Google Pay test environment):
# - Visa: 4111111111111111 (CVV: 123, Exp: 12/25)
# - MasterCard: 5555555555554444 (CVV: 123, Exp: 12/25)
# - Amex: 378282246310005 (CVV: 1234, Exp: 12/25)

# ============================================================================
# Other Required Services (for full integration testing)
# ============================================================================

# Mapbox (for station map display)
MAPBOX_TOKEN=pk.test.placeholder

# Firebase Cloud Messaging (for push notifications)
FCM_SERVER_KEY=test-fcm-server-key-placeholder

# ============================================================================
# Testing Configuration
# ============================================================================

# Set to 'true' to enable verbose logging during tests
PAYMENT_DEBUG_LOGGING=false

# Set timeout for payment gateway requests (milliseconds)
PAYMENT_GATEWAY_TIMEOUT=30000

# Set to 'true' to enable payment transaction audit logging
PAYMENT_AUDIT_LOGGING=true

# ============================================================================
# Security Notes
# ============================================================================
#
# 1. NEVER commit this file with real credentials to version control
# 2. Keep separate .env files for different environments:
#    - .env.sandbox (this file)
#    - .env.development (local development)
#    - .env.production (production - stored securely, not in repo)
# 3. Rotate all credentials every 90 days minimum
# 4. Use strong, unique API keys (at least 32 characters)
# 5. Enable IP whitelisting on payment gateway dashboards
# 6. Monitor API key usage for suspicious activity
# 7. Never log or expose credentials in error messages
# 8. Use environment-specific credentials (sandbox !== production)
#
# ============================================================================

# ============================================================================
# Quick Start
# ============================================================================
#
# 1. Copy this file: cp .env.sandbox.example .env.sandbox
# 2. Fill in your sandbox credentials
# 3. Load environment: export $(cat .env.sandbox | xargs)
# 4. Run tests: pnpm test payment-gateways.sandbox.spec.ts
#
# ============================================================================
