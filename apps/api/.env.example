# ── Core ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000                                   # HTTP API listen port
LOG_LEVEL=info
APP_NAME=lilocharge-api                     # /health service label
APP_VERSION=                                # Sentry release tag

# ── Database / Redis ────────────────────────────────────────────────
DATABASE_URL=postgresql://lilocharge:lilocharge_dev_password@localhost:5432/lilocharge?schema=public
DATABASE_CONNECTION_LIMIT=                  # optional Prisma pool size
DATABASE_POOL_TIMEOUT=                      # optional, seconds
REDIS_URL=redis://localhost:6379

# ── Auth (REQUIRED in every environment) ────────────────────────────
JWT_SECRET=change-me                        # SECRET
REFRESH_TOKEN_SECRET=change-me              # SECRET — API 500s on login without it
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d
AUTH_OTP_TTL_SECONDS=300
AUTH_REFRESH_SESSION_TTL_SECONDS=2592000

# ── CORS ────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000,http://localhost:19006   # '*' allows all

# ── SMS / OTP delivery (Twilio-compatible; OFF by default) ──────────
SMS_ENABLED=false                           # MUST be true in prod or OTPs are silently skipped
TWILIO_ACCOUNT_SID=                         # SECRET
TWILIO_AUTH_TOKEN=                          # SECRET
SMS_FROM_NUMBER=+374...
SMS_API_BASE_URL=https://api.twilio.com/2010-04-01

# ── Email (optional; silently disabled when incomplete) ─────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=                              # SECRET
SMTP_FROM_ADDRESS=noreply@lilocharge.am

# ── Payments: ArCa / Idram ──────────────────────────────────────────
ARCA_API_KEY=                               # SECRET
ARCA_MERCHANT_ID=                           # SECRET
ARCA_BASE_URL=https://sandbox.arca.am/api/v1
ARCA_WEBHOOK_SECRET=                        # SECRET — callbacks 503 without it
ARCA_PREAUTH_AMOUNT_AMD=
IDRAM_API_KEY=                              # SECRET
IDRAM_BASE_URL=https://test.wallet.idram.am/api/v1
IDRAM_WEBHOOK_SECRET=                       # SECRET — callbacks 503 without it
IDRAM_PREAUTH_AMOUNT_AMD=

# ── Payments: Apple Pay / Google Pay ────────────────────────────────
# Unset *_TOKEN_EXCHANGE_URL => local deterministic tokenization (dev only, NOT prod)
APPLE_PAY_API_KEY=                          # SECRET
APPLE_PAY_MERCHANT_IDENTIFIER=merchant.com.lilocharge
APPLE_PAY_TOKEN_EXCHANGE_URL=
GOOGLE_PAY_API_KEY=                         # SECRET
GOOGLE_PAY_MERCHANT_ID=
GOOGLE_PAY_TOKEN_EXCHANGE_URL=

# ── Uploads (S3-compatible presigning; endpoints 503 when unset) ────
UPLOADS_S3_ENDPOINT=                        # e.g. https://s3.eu-central-1.amazonaws.com
UPLOADS_S3_REGION=
UPLOADS_S3_BUCKET=
UPLOADS_S3_ACCESS_KEY_ID=                   # SECRET
UPLOADS_S3_SECRET_ACCESS_KEY=               # SECRET
UPLOADS_PUBLIC_BASE_URL=                    # public CDN/base URL; also gates review-photo validation

# ── Push notifications (Firebase Admin service account) ─────────────
FCM_ENABLED=true
FCM_PROJECT_ID=                             # or FIREBASE_PROJECT_ID / GOOGLE_APPLICATION_CREDENTIALS / FIREBASE_CONFIG
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=                            # SECRET (\n-escaped PEM)

# ── OCPP central system (WebSocket, OCPP 1.6J + 2.0.1) ──────────────
OCPP_WS_ENABLED=true
OCPP_WS_HOST=0.0.0.0
OCPP_WS_PORT=9220
OCPP_AUTH_MODE=basic                        # open | allowlist | basic (use basic in prod)
OCPP_ALLOWED_IDENTITIES=                    # comma list, allowlist mode only
OCPP_IDENTITY_SECRETS=                      # SECRET — JSON {"chargePointId":"secret"}, basic mode
OCPP_WS_TLS_CERT_PATH=                      # set both to terminate wss:// in-process
OCPP_WS_TLS_KEY_PATH=

# ── Sessions / billing ──────────────────────────────────────────────
MINIMUM_SESSION_BALANCE_AMD=1000

# ── Observability ───────────────────────────────────────────────────
SENTRY_ENABLED=true
SENTRY_DSN=                                 # SECRET-ish
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_ENABLED=true
OTEL_SERVICE_NAME=lilocharge-api
OTEL_METRICS_PORT=9464
OTEL_TRACES_EXPORTER=                       # otlp|console|zipkin|none; traces no-op when unset
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# ── Tooling / never in production ───────────────────────────────────
LOADTEST_THROTTLE_LIMIT=                    # load-test throttle override — NEVER set in prod
OPEN_CHARGE_MAP_API_KEY=                    # station-import script only
